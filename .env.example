DATABASE_URL=postgresql://user:password@localhost:5432/gc_luxury
PORT=3000

# CRM admin (/admin) — required, gates /api/brands, /api/contacts, /api/campaigns,
# /api/templates, /api/activity, /api/settings
CRM_ADMIN_KEY=change-me

# Connector admin (/connector/admin) — required, gates /api/connector/admin/*
CONNECTOR_ADMIN_KEY=change-me

# Form emails through Resend (server/notify.js) — optional; forms still save without them.
# EMAIL_FROM must be on a domain verified in Resend. Until then leave it unset, and
# NOTIFY_EMAIL can only be the Resend account's own address.
RESEND_API_KEY=
NOTIFY_EMAIL=
EMAIL_FROM=
